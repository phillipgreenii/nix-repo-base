{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "echo exact", "contract": "observe" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "echo pipe", "contract": "observe" }
        ]
      },
      {
        "matcher": "   ",
        "hooks": [
          {
            "type": "command",
            "command": "echo whitespace",
            "contract": "observe"
          }
        ]
      },
      {
        "matcher": "-",
        "hooks": [
          { "type": "command", "command": "echo dash", "contract": "observe" }
        ]
      },
      {
        "matcher": ",",
        "hooks": [
          { "type": "command", "command": "echo comma", "contract": "observe" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "echo star", "contract": "observe" }
        ]
      }
    ]
  }
}
